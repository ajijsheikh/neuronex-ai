generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id
  email     String?
  name      String?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents Document[]
  entities  Entity[]
}

model Document {
  id        String   @id @default(cuid())
  userId    String
  title     String
  type      String   @default("pdf")
  sourceUrl String?
  status    String   @default("processing")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks        Chunk[]
  relationships Relationship[]
}

model Chunk {
  id         String   @id @default(cuid())
  documentId String
  content    String
  embedding  Unsupported("vector(1536)")?
  pageNumber Int?
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model Entity {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String   @default("Concept")
  createdAt DateTime @default(now())

  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceRelationships Relationship[] @relation("SourceEntity")
  targetRelationships Relationship[] @relation("TargetEntity")

  @@unique([userId, name])
}

model Relationship {
  id               String   @id @default(cuid())
  sourceEntityId   String
  targetEntityId   String
  relationshipType String
  documentId       String?
  createdAt        DateTime @default(now())

  sourceEntity Entity    @relation("SourceEntity", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntity Entity    @relation("TargetEntity", fields: [targetEntityId], references: [id], onDelete: Cascade)
  document     Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
}
